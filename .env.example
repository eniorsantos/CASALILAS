# .env.example — referência com placeholders dummy (não são segredos reais).
# Copie para .env e ajuste para o seu ambiente local:
#   cp .env.example .env
# Produção/staging usam GitHub Secrets / Vercel / Railway — nunca commitar .env.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/plataforma"
REDIS_URL="redis://localhost:6379"
APP_URL="http://localhost:3000"

# Auth.js
AUTH_SECRET="dev-secret-change-me"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT do app mobile (POST /api/mobile/login assina com ele; produção exige valor real)
JWT_SECRET="dev-jwt-secret-change-me"

# Stripe (chaves de TESTE em staging/dev; reais só via Vercel/Railway env vars)
STRIPE_SECRET_KEY="sk_test_dummy"
STRIPE_WEBHOOK_SECRET="whsec_dummy"

# Mercado Pago (token de TESTE)
MP_ACCESS_TOKEN="TEST_DUMMY"

# Mux
MUX_TOKEN_ID="dummy"
MUX_TOKEN_SECRET="dummy"
MUX_SIGNING_KEY_ID="dummy"
MUX_SIGNING_KEY_PRIVATE="ZHVtbXktc2lnbmluZy1rZXk="

# Bunny (alternativa ao Mux)
BUNNY_LIBRARY_ID="dummy"
BUNNY_TOKEN_SECURITY_KEY="dummy"

# Emails
RESEND_API_KEY="re_dummy"

# Storage (R2/S3) para certificados
STORAGE_BUCKET="dev-bucket"
STORAGE_PUBLIC_URL="https://storage.local"

# CORS das rotas /api/mobile/* (origens separadas por vírgula; painel Vite local)
CORS_ORIGINS="http://localhost:5173"
