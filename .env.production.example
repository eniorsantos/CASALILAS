# .env.production.example — TEMPLATE para deploy local em modo produção.
# Copie para .env.production e preencha. NUNCA commitar o .env.production.
# Porta padrão do Postgres prod: 5433 (não conflita com o dev :5432).
# Porta padrão do Redis prod: 6380 (não conflita com o dev :6379).

# --- Infra (compose prod) ---
POSTGRES_USER=plataforma
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=plataforma
POSTGRES_PORT=5433
REDIS_PASSWORD=troque-esta-senha
REDIS_PORT=6380

# --- Banco/Redis (apontam para o compose prod) ---
# Formato: postgresql://USUARIO:SENHA@localhost:PORTA/BANCO
DATABASE_URL=
# Formato: redis://:SENHA@localhost:PORTA  (note os dois-pontos antes da senha)
REDIS_URL=

# --- App ---
APP_URL=http://localhost:3000
PORT=3000
AUTH_SECRET=gere-com-npx-auth-secret
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=gere-um-valor-longo-aleatorio
CORS_ORIGINS=http://localhost:4173

# --- Pagamentos (TESTE aqui; LIVE só em produção real — ver DEPLOY-PRODUCAO.md) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MP_ACCESS_TOKEN=

# --- Vídeo / email / storage ---
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE=
BUNNY_LIBRARY_ID=
BUNNY_TOKEN_SECURITY_KEY=
RESEND_API_KEY=
STORAGE_BUCKET=
STORAGE_PUBLIC_URL=

# --- Seed do admin (usado uma vez pelo scripts/seed-admin.ts; apague depois) ---
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Painel web Vite (frontend/web/.env) ---
# VITE_API_URL=http://localhost:3000
