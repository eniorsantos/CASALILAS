# URL base do backend Next.js (Expo lê EXPO_PUBLIC_* no build/dev).
# No celular físico use o IP da máquina, não localhost:
# EXPO_PUBLIC_API_URL=http://192.168.0.10:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Google OAuth (login social) — Client IDs do Google Cloud Console.
# Sem eles, o botão Google mostra erro em vez de abrir o fluxo.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
